# Local infrastructure only. ACCEPT_EULA=Y accepts the SQL Server and Service Bus emulator EULAs.
ACCEPT_EULA=Y
MSSQL_SA_PASSWORD=LocalOnly_SA_2026!
SQL_PORT=1433
SQL_WAIT_INTERVAL=5
SERVICE_BUS_AMQP_PORT=5672
SERVICE_BUS_MANAGEMENT_PORT=5300
API_PORT=5080
WORKER_PORT=5081

# Application credentials are created by database/local/app_login.sql.
ORDERS_DB_COMPOSE_CONNECTION_STRING=Server=sql,1433;Database=OrdersDb;User ID=orders_app_local;Password=LocalOnly_OrdersDb_2026!;Encrypt=True;TrustServerCertificate=True
SERVICE_BUS_COMPOSE_CONNECTION_STRING=Endpoint=sb://emulator;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;
